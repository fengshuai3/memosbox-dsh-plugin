{
  "name": "memosbox-dsh-plugin",
  "version": "0.2.0-beta.3",
  "description": "Native DeepSeek Harness bundle for governed MemOS memory, a Markdown wiki, and local Mirobody health-data normalization.",
  "author": { "name": "冯帅", "email": "714205152@qq.com" },
  "repository": { "type": "git", "url": "https://gitee.com/guandalaifu/memosbox-dsh-plugin.git" },
  "homepage": "https://gitee.com/guandalaifu/memosbox-dsh-plugin",
  "bugs": { "url": "https://gitee.com/guandalaifu/memosbox-dsh-plugin/issues" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.zh-CN.md",
    "docs/DEVELOPMENT_PLAN.zh-CN.md",
    "docs/RUNTIME_GUIDE.zh-CN.md",
    "vendor/memos-core",
    "python",
    "runtime-locks",
    "scripts/provision-runtime.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-memos-core.mjs && tsc -p tsconfig.json",
    "build:vendor": "node scripts/build-memos-core.mjs",
    "build:vendor:check": "node scripts/build-memos-core.mjs --check",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "audit:release": "node scripts/audit-dependencies.mjs --prod",
    "audit:development": "node scripts/audit-dependencies.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:source-check": "node scripts/source-release-check.mjs",
    "prepublishOnly": "node scripts/release-check.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepack": "npm run clean && npm run verify"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memos",
    "memory",
    "wiki",
    "knowledge-base",
    "cordis"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "12.11.1",
    "proper-lockfile": "4.1.2",
    "uuid": "14.0.2",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-sandbox": { "optional": true },
    "@deepseek-ai/dsh-sandbox-policy": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-timeout": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@memtensor/memos-local-plugin": "2.0.19",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "22.18.3",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
